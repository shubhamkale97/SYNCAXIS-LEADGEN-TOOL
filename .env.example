# Address on the host where the Syncaxis Leadgen web interface should listen.
# Use 127.0.0.1 for local-only access, a specific LAN IP for LAN access,
# or 0.0.0.0 for every network interface.
HOST_BIND=127.0.0.1

# --- Access control ---------------------------------------------------------
# Strongly recommended whenever HOST_BIND is not 127.0.0.1: set BOTH to require
# HTTP Basic authentication for the UI and API (browsers show a login prompt).
# Use a long random password; add TLS (reverse proxy) before exposing it beyond
# a trusted network. /healthz stays open for container health checks.
AUTH_USER=
AUTH_PASSWORD=
# Max expensive requests (searches, geocoding) per client address per minute.
# 0 disables the limit. Behind a reverse proxy every request shares its address.
RATE_LIMIT_PER_MIN=60

# Optional: enables Google's official Geocoding API for location resolution.
# This key stays on the server. Restrict it by IP / to the Geocoding API.
GOOGLE_MAPS_API_KEY=
# Optional: a SEPARATE key for the Google map shown in the browser (Maps
# JavaScript API, restricted by HTTP referrer). It is sent to every visitor, so
# do not reuse the server key above. If unset, the server key is used for both.
GOOGLE_MAPS_BROWSER_KEY=

# Optional: HERE Maps API key. Used for the map when no Google key is set.
HERE_API_KEY=

# Which map to use: auto | google | here | osm. "auto" prefers Google, then
# HERE, then keyless OpenStreetMap. Set to "here" to pin HERE.
MAP_PROVIDER=here

# Contact (email or URL) added to the User-Agent sent to OpenStreetMap services,
# as the Nominatim usage policy asks. Optional but polite.
NOMINATIM_CONTACT=

# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Company industry from job postings -----------------------------------
# Which job sources to enable, comma separated. When unset only the API-based
# sources run: ats, adzuna, jooble, serpapi (each needs its key where noted;
# "ats" only runs for company lookups). The scraping sources "linkedin" and
# "jobspy" are NOT on by default - they breach those sites' terms and risk IP
# blocks; add them here only if you accept that, e.g.
#   JOB_SOURCES=ats,adzuna,jooble,serpapi,linkedin
JOB_SOURCES=ats,adzuna,jooble,serpapi

# Adzuna (free tier; broad coverage incl. India). Register at developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Jooble (free key on request at jooble.org/api/about)
JOOBLE_API_KEY=

# SerpAPI (Google Jobs panel; 250 free searches/month)
SERPAPI_API_KEY=

# Successful job lookups are cached (SQLite, in the leadgen_meta volume) so
# repeat searches do not spend API quota. Seconds; 0 disables. Default 6 hours.
JOBS_CACHE_TTL=21600

# LinkedIn guest-endpoint scraper (only used if "linkedin" is in JOB_SOURCES).
# No key needed, but scraping is against LinkedIn's User Agreement. Keep volume low.
LINKEDIN_DELAY=3.5
LINKEDIN_PAGES=3
# Optional residential proxy for the LinkedIn source, e.g. http://user:pass@host:port
LINKEDIN_PROXY=

# Browser TLS fingerprint to impersonate (via curl_cffi), and HTTP retry attempts.
IMPERSONATE_BROWSER=chrome
HTTP_ATTEMPTS=3

# LinkedIn render engine: auto | playwright (headless Chromium) | curl_cffi.
LINKEDIN_ENGINE=playwright
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
# Headless Chromium instances allowed at once (each is memory hungry). Extra
# searches wait up to BROWSER_QUEUE_TIMEOUT seconds, then fall back to plain HTTP.
BROWSER_MAX_CONCURRENCY=1
BROWSER_QUEUE_TIMEOUT=120
# Memory limit for the web container (Docker syntax, e.g. 2g).
WEB_MEM_LIMIT=2g

# JobSpy (optional multi-board library; needs the python-jobspy package).
JOBSPY_SITES=linkedin,indeed,glassdoor,google,naukri
JOBSPY_COUNTRY=india
# Fetch full job descriptions (slower, but improves field matching accuracy).
JOBSPY_FETCH_DESCRIPTION=false

# ATS boards (keyless, no scraping - employers' own careers pages).
ATS_PROVIDERS=greenhouse,lever,ashby

# Optional LLM fallback for ambiguous company classification (OpenAI-compatible).
# The model must answer with one of the built-in industries; anything else is ignored.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
