# Address on the host where the Atlas web interface should listen.
# Use 127.0.0.1 for local-only access, a specific LAN IP for LAN access,
# or 0.0.0.0 for every network interface.
HOST_BIND=127.0.0.1

# Optional: enables Google's official Geocoding API for location resolution.
# With a key that also has the Maps JavaScript API enabled, the map uses Google
# Maps. Restrict the key by HTTP referrer - it is sent to the browser.
GOOGLE_MAPS_API_KEY=

# Optional: HERE Maps API key. Used for the map when no Google key is set.
HERE_API_KEY=

# --- Company industry from job postings -----------------------------------
# Which job sources to enable, comma separated. Every source below has a free
# tier, so all of them run free by default. Leave unset to auto-select every
# source whose credentials are present.
# Names: ats, linkedin, jobspy, adzuna, jooble, serpapi.
JOB_SOURCES=ats,linkedin,jobspy,adzuna,jooble,serpapi

# Adzuna (free tier; broad coverage incl. India). Register at developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Jooble (free key on request at jooble.org/api/about)
JOOBLE_API_KEY=

# SerpAPI (Google Jobs panel; 250 free searches/month)
SERPAPI_API_KEY=

# LinkedIn guest-endpoint scraper. No key needed, but scraping is against
# LinkedIn's User Agreement. Keep volume low.
LINKEDIN_DELAY=3.5
LINKEDIN_PAGES=3
# Optional residential proxy for the LinkedIn source, e.g. http://user:pass@host:port
LINKEDIN_PROXY=

# Browser TLS fingerprint to impersonate (via curl_cffi), and HTTP retry attempts.
IMPERSONATE_BROWSER=chrome
HTTP_ATTEMPTS=3

# LinkedIn render engine: auto | playwright (headless Chromium) | curl_cffi.
LINKEDIN_ENGINE=playwright
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000

# JobSpy (optional multi-board library; needs the python-jobspy package).
JOBSPY_SITES=linkedin,indeed,glassdoor,google,naukri
JOBSPY_COUNTRY=india
# Fetch full job descriptions (slower, but improves field matching accuracy).
JOBSPY_FETCH_DESCRIPTION=false

# ATS boards (keyless, no scraping - employers' own careers pages).
ATS_PROVIDERS=greenhouse,lever,ashby

# Optional LLM fallback for ambiguous company classification (OpenAI-compatible).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
