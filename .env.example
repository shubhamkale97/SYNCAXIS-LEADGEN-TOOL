# Address on the host where the Atlas web interface should listen.
# Use 127.0.0.1 for local-only access, a specific LAN IP for LAN access,
# or 0.0.0.0 for every network interface.
HOST_BIND=127.0.0.1

# Optional: enables Google's official Geocoding API for location resolution.
GOOGLE_MAPS_API_KEY=

# --- Company industry from job postings -----------------------------------
# Which job sources to enable, comma separated. Every source below has a free
# tier, so all four run free by default. Leave unset to auto-select every
# source whose credentials are present.
JOB_SOURCES=linkedin,adzuna,jooble,serpapi

# Adzuna (free tier; broad coverage incl. India). Register at developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Jooble (free key on request at jooble.org/api/about)
JOOBLE_API_KEY=

# SerpAPI (Google Jobs panel; 250 free searches/month)
SERPAPI_API_KEY=

# LinkedIn guest-endpoint scraper. No key needed, but scraping is against
# LinkedIn's User Agreement. Keep volume low.
LINKEDIN_DELAY=3.5
LINKEDIN_PAGES=3
# Optional residential proxy for the LinkedIn source, e.g. http://user:pass@host:port
LINKEDIN_PROXY=

# Optional LLM fallback for ambiguous company classification (OpenAI-compatible).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
